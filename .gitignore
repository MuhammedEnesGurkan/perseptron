# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local analysis history
/data/*.jsonl
/downloaded-eurosat/
.codex-backup/

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]
models/best_convnext_tiny_uydu.pth
models/models.rar

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.server-logs/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datasets and large files
/Dataset/
/credit_default_mlp_model/
/*.zip

# python cache
**/__pycache__/
*.pyc
